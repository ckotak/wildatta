#!/bin/sh
# Scans the commits being pushed for secrets and forbidden files.
. "$(git rev-parse --show-toplevel)/scripts/check-forbidden-files.sh"
root=$(git rev-parse --show-toplevel)
zero=0000000000000000000000000000000000000000

while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue   # branch deletion
  if [ "$remote_sha" = "$zero" ]; then range="$local_sha --not --remotes"; else range="$remote_sha..$local_sha"; fi
  files=$(git log --format= --name-only --diff-filter=ACMR $range | sort -u)
  check_forbidden_files "$files" || exit 1
  if command -v gitleaks >/dev/null 2>&1; then
    gitleaks git --redact --config "$root/.gitleaks.toml" --log-opts="$range" || exit 1
  else
    echo "pre-push: gitleaks is not installed, so the secret scan was skipped (CI still scans)."
  fi
done
exit 0
